{
  "name": "@giveitsmaller/sdk",
  "version": "0.30.0",
  "gislContractsSpec": "v2.210.0",
  "description": "Node.js SDK for the GISL (Give It Smaller) file compression and processing API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.browser.d.ts",
      "default": "./dist/index.browser.js"
    }
  },
  "browser": {
    "./dist/index.js": "./dist/index.browser.js",
    "./dist/node-fs.js": "./dist/node-fs.browser.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@giveitsmaller/contracts": "^0.75.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.27",
    "typescript": "5.9.3",
    "vitest": "^3.1 <3.2.5",
    "yaml": "^2.6"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude tests/browser-bundle.test.ts; main=$?; vitest run tests/browser-bundle.test.ts && exit $main",
    "test:parity": "vitest run tests/parity",
    "parity:update": "UPDATE_PARITY_FIXTURES=1 vitest run tests/parity",
    "api:update": "UPDATE_API_SNAPSHOT=1 vitest run tests/api-surface.test.ts"
  },
  "homepage": "https://docs.giveitsmaller.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giveitsmaller/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/giveitsmaller/typescript-sdk/issues"
  }
}
